<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The only entitlement needed for NAT networking, storage, display and sharing.
	     com.apple.vm.networking (bridged) is restricted and needs Apple approval. -->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
